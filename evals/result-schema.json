{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "summary", "results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "matrix_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "not_run"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "environment", "skill", "type", "case_id", "status"],
        "properties": {
          "host": {"enum": ["claude-code", "codex"]},
          "environment": {"enum": ["isolated", "superset"]},
          "skill": {"type": "string", "minLength": 1},
          "type": {
            "enum": ["positive", "nearest_negative", "ambiguous", "explicit", "no_skill_negative", "negative_trigger"]
          },
          "case_id": {"type": "integer", "minimum": 1},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "actual": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
